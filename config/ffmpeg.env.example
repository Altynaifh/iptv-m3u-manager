# 本机截图检测用 FFmpeg（已下载到本项目，一般不用改）
# 复制为 ffmpeg.env 后按需修改；或在 PowerShell 里 source 本文件

# 默认：项目内 4.4.1（与 Docker 4.4.2 同代）
# 留空则程序自动使用 tools\ffmpeg-4.4-win64\bin\ffmpeg.exe
FFMPEG_PATH=

# 设为 1 时，没有 4.4 包才会用 PATH 里的系统 ffmpeg（如 7.1）
ALLOW_SYSTEM_FFMPEG=0

# 截图并发与超时（可选，需在代码中读取时才生效；当前版本见 stream_checker.py 默认值 5 / 15s）
# FFMPEG_CAPTURE_CONCURRENCY=3
# FFMPEG_CAPTURE_TIMEOUT_SEC=25
